{
  "manifest_version": 3,
  "name": "Anime Progress Tracker",
  "version": "1.2.0",
  "description": "Track anime progress. Manual GitHub Gist sync or export/import between desktop and Android.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": ["js/storage.js", "js/gist.js", "js/background.js"]
  },
  "action": {
    "default_popup": "html/popup.html"
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/storage.js", "js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "anime-tracker-sync@yourdomain.com",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  }
}
