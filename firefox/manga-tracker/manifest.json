{
  "manifest_version": 3,
  "name": "Manga Progress Tracker",
  "version": "1.0.5",
  "description": "Track manga reading progress. Export/import to move data between desktop and Android.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["storage.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-tracker-sync@yourdomain.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}